#!/bin/sh
# ani-id-cli — search, stream, and download anime from otakudesu.blog
# POSIX sh; see README.md for dependencies and usage.

version_number="0.1.0"

base_url="${ANI_ID_BASE:-https://otakudesu.blog}"
user_agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
referer="${base_url%/}/"

die() {
    printf "\33[2K\r\033[1;31m%s\033[0m\n" "$*" >&2
    exit 1
}

info() {
    printf "\33[2K\r\033[1;34m%s\033[0m\n" "$*"
}

warn() {
    printf "\33[2K\r\033[1;33m%s\033[0m\n" "$*" >&2
}

# SCRAPING

decode_entities() {
    sed -e "s/&#0*39;/'/g" \
        -e 's/&#8217;/'"'"'/g' \
        -e 's/&#8211;/-/g' \
        -e 's/&#8212;/--/g' \
        -e 's/&#8220;/"/g' \
        -e 's/&#8221;/"/g' \
        -e 's/&quot;/"/g' \
        -e 's/&lt;/</g' \
        -e 's/&gt;/>/g' \
        -e 's/&amp;/\&/g'
}

# search results: url<TAB>title
parse_search() {
    tr '\n' ' ' |
        sed 's|<h2><a |\
<h2><a |g' |
        sed -nE 's|.*<h2><a href="([^"]+)"[^>]*>(.*)</a></h2>.*|\1\t\2|p' |
        decode_entities
}

# episode list: episode<TAB>url, ascending
parse_episodes() {
    tr '\n' ' ' |
        sed 's|<div class="episodelist">|\
<div class="episodelist">|g' |
        sed -n '/<div class="episodelist">/p' |
        sed 's|<li>|\
<li>|g' |
        sed -nE 's|.*<a href="([^"]*/episode/[^"]*)"[^>]*>[^<]*Episode ([0-9]+(\.[0-9]+)?)[^<]*</a>.*|\2\t\1|p' |
        sort -n -k1,1 |
        uniq
}

# episode page title
parse_episode_title() {
    tr '\n' ' ' |
        sed -nE 's|.*<h1 class="posttl">([^<]*)</h1>.*|\1|p' |
        decode_entities
}

# primary player iframe on the episode page
parse_embed_url() {
    tr '\n' ' ' |
        sed 's|<div class="player-embed"|\
<div class="player-embed"|g' |
        sed -n '/<div class="player-embed"/p' |
        grep -oE '<iframe[^>]*src="[^"]+"' |
        head -n 1 |
        sed -E 's|.*src="([^"]+)".*|\1|'
}

# direct mp4 from the embed page
parse_video_url() {
    _page="$(tr '\n' ' ')"
    _url="$(printf '%s' "$_page" | sed -nE 's|.*videoURL[[:space:]]*=[[:space:]]*"([^"]+)".*|\1|p' | head -n 1)"
    [ -z "$_url" ] && _url="$(printf '%s' "$_page" | sed -nE 's|.*file[[:space:]]*:[[:space:]]*"([^"]+\.mp4[^"]*)".*|\1|p' | head -n 1)"
    printf '%s\n' "$_url"
}

main() {
    printf 'ani-id-cli %s\n' "$version_number"
}

# Sourced by the test runner: define functions, do not run.
if [ "${ANI_ID_CLI_LIB:-0}" != 1 ]; then
    main "$@"
fi
